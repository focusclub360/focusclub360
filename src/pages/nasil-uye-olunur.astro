---
import Layout from '../layouts/Layout.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import heroGorsel from '../assets/nasil-uye-olunur-hero.jpg';
import { KAYIT_URL, ROUTES } from '../config';

const menu = [
  { ad: 'Kulüpte Neler Var', href: ROUTES.kulupteNelerVar },
  { ad: 'Nasıl Çalışır',     href: ROUTES.nasilCalisir    },
  { ad: 'Velilere',          href: ROUTES.velilere         },
  { ad: 'Nasıl Üye Olunur',  href: ROUTES.nasilUyeOlunur  },
  { ad: 'Rehber',            href: ROUTES.rehber           },
];

const adimlar = [
  {
    no:       '01',
    baslik:   'Ön Kayıt Formunu Doldurun',
    aciklama: 'Kısa formu doldurup veli ve öğrenci bilgilerinizi bırakın.',
    renk:     'bg-mor',
  },
  {
    no:       '02',
    baslik:   'Sizi Arayalım',
    aciklama: 'Ekibimiz iletişime geçer; süreci ve güncel dönem bilgisini paylaşır.',
    renk:     'bg-mavi',
  },
  {
    no:       '03',
    baslik:   'İlk Etüde Katılın',
    aciklama: 'Çocuğunuz gerçek öğretmen gözetiminde ilk canlı etüdüne girer.',
    renk:     'bg-turkuaz',
  },
];

const ozellikler = [
  { baslik: 'Canlı Etüt ve Soru Çözümü',      aciklama: 'Branş öğretmenleriyle gerçek zamanlı etüt.',        ikon: 'users',  renk: 'bg-turkuaz'  },
  { baslik: 'Gerçek Başarı Koçluğu',           aciklama: 'Kişiye özel hedef takibi ve motivasyon desteği.',   ikon: 'target', renk: 'bg-mor'      },
  { baslik: 'Yapay Zekâ Takibi ve Analizler',  aciklama: 'Her adım akıllı sistemle izlenir ve raporlanır.',  ikon: 'cpu',    renk: 'bg-lacivert' },
  { baslik: 'Online Ders İçerikleri',           aciklama: 'Tüm branşlarda video anlatım ve çözümlü sorular.', ikon: 'video',  renk: 'bg-mavi'     },
  { baslik: 'Deneme Kulübü',                    aciklama: 'Her döneme özel adresinize basılı deneme paketi.', ikon: 'mail',   renk: 'bg-[#06B6D4]' },
  { baslik: 'Veli Raporlama ve Bildirimler',    aciklama: 'Haftalık şeffaf ilerleme raporu veliye iletilir.', ikon: 'bell',   renk: 'bg-mercan'   },
];

const sss = [
  {
    soru:  'Ön Kayıt Ne Anlama Geliyor?',
    cevap: 'Ön kayıt, bilgilerinizi bize bırakmanız demektir. Herhangi bir yükümlülük doğurmaz; ekibimiz sizinle iletişime geçerek süreci anlatır.',
  },
  {
    soru:  'Ne Zaman Dönüş Yapılıyor?',
    cevap: 'Ön kaydınızı aldıktan sonra en kısa sürede sizinle iletişime geçiyoruz. Ayrıca e-posta adresinize bir bilgilendirme gönderiyoruz.',
  },
  {
    soru:  'Hangi Sınıf Seviyesine Yöneliksiniz?',
    cevap: 'Yalnızca 8. sınıf ve LGS sürecine odaklanıyoruz.',
  },
];
---

<Layout
  title="Nasıl Üye Olunur | FocusClub 360"
  description="Üç adımda aramıza katılın. Ön kayıt formunu doldurun, ekibimiz sizinle iletişime geçsin."
>
  <div class="theme-v13 bg-[#131629] md:bg-[#131629] md:p-4">
    <div class="mx-auto max-w-[1400px] bg-white md:rounded-[8px] md:shadow-[0_30px_80px_rgba(110,124,255,.18)]">

      <!-- Sticky header -->
      <div class="sticky top-0 z-50">
        <header class="flex items-center justify-between gap-4 px-6 py-3 backdrop-blur-sm md:rounded-t-[8px] md:py-4 md:px-10" style="background-color: rgba(27,33,64,0.97);">
          <a href="/" class="flex items-center" aria-label="FocusClub 360"><img src="/FocusClub360_logo_turuncu.png" alt="FocusClub 360" class="h-[54px] w-auto md:h-[72px]" /></a>

          <nav class="hidden items-center gap-7 lg:flex">
            {menu.map((m) => (
              <a
                href={m.href}
                class={`text-sm transition ${m.href === ROUTES.nasilUyeOlunur ? 'font-semibold text-[#FFFFFF]' : 'font-medium text-[#8B96CC] hover:text-[#FFFFFF]'}`}
              >
                {m.ad}
              </a>
            ))}
          </nav>

          <div class="flex items-center gap-2 sm:gap-3">
            <a
              href={ROUTES.bizeUlasin}
              class="hidden rounded-buton bg-gradient-to-r from-[#6E7CFF] to-[#2D3AAE] px-5 py-2.5 text-sm font-semibold text-beyaz shadow-[0_8px_20px_rgba(110,124,255,.40)] transition hover:brightness-110 sm:inline-block"
            >Bize Ulaşın</a>
            <button id="mob-tog" aria-label="Menüyü aç" class="grid h-9 w-9 shrink-0 place-items-center rounded-[8px] border border-kenar text-[#FFFFFF] transition hover:bg-bulut focus:outline-none active:bg-[#1E2848] lg:hidden" style="-webkit-tap-highlight-color: transparent; background-color: #1B2140; -webkit-appearance: none; appearance: none;">
              <Icon name="menu" size={20} />
            </button>
          </div>
        </header>

        <!-- Marka satırı — header ile sabit (mobil/tablet) -->
        <div class="border-b border-kenar px-6 py-2 md:px-10 lg:hidden" style="background-color: rgba(27,33,64,0.97);">
          <p class="text-[13px] font-semibold leading-tight text-[#F1683C]">
            TÜRKİYE'NİN İLK VE TEK<br />DİJİTAL AKADEMİK ETÜT KULÜBÜ
          </p>
        </div>

        <nav id="mob-nav" class="hidden border-b border-kenar px-6 pb-5 pt-2 lg:hidden" style="background-color: #1B2140;">
          <div class="flex flex-col">
            {menu.map((m) => (
              <a href={m.href} class="mob-link rounded-[8px] px-3 py-2.5 text-sm font-medium text-[#8B96CC] transition hover:bg-bulut hover:text-[#FFFFFF]">{m.ad}</a>
            ))}
          </div>
          <a
            href={ROUTES.bizeUlasin}
            class="mt-3 flex items-center justify-center gap-2 rounded-[8px] bg-gradient-to-r from-[#6E7CFF] to-[#2D3AAE] py-3 text-sm font-semibold text-beyaz"
          >
Bize Ulaşın
            <Icon name="arrow" size={16} />
          </a>
        </nav>
      </div>

      <!-- ── 1. HERO (banner) ──────────────────────────────────────────────────── -->
      <div class="flex min-h-[calc(100svh-8rem)] flex-col md:min-h-[calc(100vh-9rem)]">
        <div class="flex min-h-0 flex-1 flex-col px-6 pb-4 md:px-10 md:pb-6">

          <!-- Badge -->
          <div class="pb-2 pt-3 md:pb-3 md:pt-4">
            <span class="flex w-full items-center gap-1 rounded-md bg-[#ede8ff] px-2.5 py-1 text-[14px] font-semibold text-[#3b6ef0] md:inline-flex md:w-auto md:gap-1.5 md:bg-gradient-to-r md:from-[#7c5cfc]/12 md:to-[#3b6ef0]/12 md:px-3 md:py-1 md:text-[18px]">
              <Icon name="star" size={12} class="text-[#7c5cfc] md:size-[14px]" />
              Nasıl Üye Olunur?
            </span>
          </div>

          <!-- Banner -->
          <div class="relative min-h-0 flex-1 overflow-hidden rounded-[8px]">
            <Image
              src={heroGorsel}
              alt="FocusClub 360 nasıl üye olunur"
              widths={[768, 1280, 1600]}
              sizes="100vw"
              class="absolute inset-0 h-full w-full object-cover object-center"
              loading="eager"
            />
            <div class="absolute inset-0 md:hidden" style="background-color: rgba(19,22,41,0.75);"></div>
            <div class="absolute inset-0 hidden md:block" style="background: linear-gradient(to right, rgba(19,22,41,0.83) 0%, rgba(19,22,41,0.38) 45%, rgba(19,22,41,0.09) 100%);"></div>

            <!-- İçerik -->
            <div class="absolute inset-0 z-10 flex flex-col justify-evenly px-5 py-4 md:px-10 md:py-10">

              <div class="max-w-[62%] md:max-w-lg">
                <h1 class="font-baslik text-2xl font-extrabold tracking-tight text-white md:text-4xl lg:text-[2.8rem]" style="line-height: 1.2;">
                  Üç Adımda Aramıza Katılın
                </h1>
                <p class="mt-2 text-sm text-white/80 md:mt-4 md:text-base">
                  Ön kayıt formunu doldurun; ekibimiz sizinle iletişime geçerek süreci ve güncel dönem bilgisini paylaşsın.
                </p>
              </div>

              <div>
                <div class="flex flex-wrap gap-2 md:gap-3">
                  <a
                    href={KAYIT_URL}
                    class="inline-flex items-center gap-2 rounded-buton bg-gradient-to-r from-[#7c5cfc] to-[#3b6ef0] py-1.5 pl-4 pr-1.5 text-sm font-semibold text-beyaz shadow-[0_12px_30px_rgba(40,40,120,.35)] transition hover:brightness-105 md:gap-3 md:py-2.5 md:pl-6 md:pr-2.5 md:text-base"
                  >
                    Ön Kayıt Formu
                    <span class="grid h-7 w-7 place-items-center rounded-full bg-white text-[#3b6ef0] md:h-9 md:w-9">
                      <Icon name="arrow" size={15} />
                    </span>
                  </a>
                  <a
                    href={ROUTES.kulupteNelerVar}
                    class="inline-flex items-center gap-2 rounded-buton border border-white/40 px-4 py-1.5 text-sm font-semibold text-white transition hover:bg-white/10 md:px-6 md:py-2.5 md:text-base"
                  >
                    Kulüpte Neler Var
                  </a>
                </div>
              </div>

            </div>
          </div>
        </div>
      </div>

      <!-- ── 2. ÜÇ ADIMDA ÜYELİK ───────────────────────────────────────────────── -->
      <section class="bg-[#f5f8ff] px-6 py-14 md:px-10 md:py-20">
        <div class="mx-auto max-w-[1400px]">

          <div class="reveal mx-auto max-w-2xl text-center">
            <h2 class="font-baslik text-3xl font-bold text-[#1b2a5b] md:text-4xl">Üç Adımda Aramıza Katılın</h2>
            <p class="mt-3 text-base text-[#5b6488]">Kayıt dakikalar içinde tamamlanır, sistem hemen açılır.</p>
          </div>

          <!-- Masaüstü: yan yana üç kart -->
          <div class="reveal mt-12 hidden items-stretch gap-0 md:flex">
            {adimlar.map((a, i) => (
              <div class="flex flex-1 items-stretch">
                <div class="flex flex-1 flex-col rounded-[8px] border border-kenar bg-white p-7 shadow-[0_4px_16px_rgba(60,80,180,.06)]">
                  <span class={`grid h-12 w-12 place-items-center rounded-full text-lg font-extrabold text-white shadow-[0_4px_12px_rgba(110,124,255,.25)] ${a.renk}`}>
                    {a.no}
                  </span>
                  <h3 class="mt-5 font-baslik text-base font-bold text-[#1b2a5b]">{a.baslik}</h3>
                  <p class="mt-2 flex-1 text-sm leading-relaxed text-[#5b6488]">{a.aciklama}</p>
                </div>
                {i < 2 && (
                  <div class="flex w-10 shrink-0 items-center justify-center text-[#5b6488]">
                    <Icon name="arrow" size={18} />
                  </div>
                )}
              </div>
            ))}
          </div>

          <!-- Mobil: dikey liste -->
          <div class="reveal mt-8 flex flex-col gap-3 md:hidden">
            {adimlar.map((a) => (
              <div class="flex items-start gap-4 rounded-[8px] border border-kenar bg-white p-5">
                <span class={`grid h-10 w-10 shrink-0 place-items-center rounded-full text-sm font-extrabold text-white ${a.renk}`}>
                  {a.no}
                </span>
                <div>
                  <h3 class="font-baslik text-sm font-bold text-[#1b2a5b]">{a.baslik}</h3>
                  <p class="mt-1 text-xs leading-relaxed text-[#5b6488]">{a.aciklama}</p>
                </div>
              </div>
            ))}
          </div>

          <!-- Üye Ol butonu (dış kayıt linki) -->
          <div class="reveal mt-10 flex justify-center">
            <a
              href={KAYIT_URL}
              class="inline-flex items-center gap-2 rounded-buton bg-gradient-to-r from-[#7c5cfc] to-[#3b6ef0] py-3 pl-7 pr-3 text-base font-semibold text-beyaz shadow-[0_12px_30px_rgba(40,40,120,.35)] transition hover:brightness-105"
            >
              Ön Kayıt Formu
              <span class="grid h-9 w-9 place-items-center rounded-full bg-white text-[#3b6ef0]">
                <Icon name="arrow" size={16} />
              </span>
            </a>
          </div>

        </div>
      </section>

      <!-- ── 3. TEK ÜYELİK ─────────────────────────────────────────────────────── -->
      <section class="bg-[#f5f8ff] px-6 py-14 md:px-10 md:py-20">
        <div class="mx-auto max-w-[1400px]">

          <div class="reveal mx-auto max-w-2xl text-center">
            <h2 class="font-baslik text-2xl font-bold text-[#1b2a5b] md:text-3xl">Tek Üyelik, Her Şey Dahil</h2>
            <p class="mt-2 text-sm text-[#5b6488]">İhtiyacınız olan her şey bir arada.</p>
          </div>

          <div class="reveal mt-10 rounded-[8px] border border-kenar bg-beyaz shadow-yumusak">
            <div>

              <!-- Dahil olanlar -->
              <div class="p-8 md:p-10">
                <p class="text-xs font-semibold uppercase tracking-widest text-[#5b6488]">Üyeliğe Dahil Olanlar</p>
                <ul class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
                  {ozellikler.map((o) => (
                    <li class="flex items-start gap-4">
                      <span class={`grid h-10 w-10 shrink-0 place-items-center rounded-[8px] text-beyaz ${o.renk}`}>
                        <Icon name={o.ikon} size={20} />
                      </span>
                      <div>
                        <p class="text-sm font-semibold text-[#1b2a5b]">{o.baslik}</p>
                        <p class="mt-0.5 text-xs leading-relaxed text-[#5b6488]">{o.aciklama}</p>
                      </div>
                    </li>
                  ))}
                </ul>
              </div>

            </div>
          </div>

        </div>
      </section>

      <!-- ── 4. KAYIT DÖNEMLERİ ─────────────────────────────────────────────────── -->
      <section class="bg-white px-6 py-14 md:px-10 md:py-20">
        <div class="mx-auto max-w-[1400px]">
          <div class="reveal mx-auto max-w-2xl text-center">
            <h2 class="font-baslik text-3xl font-bold text-[#1b2a5b] md:text-4xl">Kayıt Dönemleri</h2>
            <p class="mt-5 text-base leading-relaxed text-[#5b6488]">
              Akademik yıl kademeli kayıt dönemlerine ayrılır. Dilediğiniz dönemde aramıza katılabilir, çocuğunuzun düzenini erkenden kurmaya başlayabilirsiniz.
            </p>
            <p class="mt-6 text-sm text-[#5b6488]/60">
              Güncel dönem bilgisini üyelik sırasında görürsünüz.
            </p>
          </div>
        </div>
      </section>

      <!-- ── 5. KISA SSS + CTA ──────────────────────────────────────────────────── -->
      <section class="bg-[#f5f8ff] px-6 pb-14 pt-14 md:px-10 md:pb-20 md:pt-20">
        <div class="mx-auto max-w-[1400px]">

          <div class="reveal mx-auto max-w-2xl text-center">
            <h2 class="font-baslik text-3xl font-bold text-[#1b2a5b] md:text-4xl">Aklınıza Takılanlar</h2>
          </div>

          <div class="reveal mx-auto mt-10 max-w-2xl divide-y divide-kenar overflow-hidden rounded-[8px] border border-kenar bg-beyaz">
            {sss.map((s) => (
              <details class="faq-item group px-6 py-5">
                <summary class="flex cursor-pointer list-none items-center justify-between gap-4 select-none">
                  <span class="font-baslik text-sm font-semibold text-[#1b2a5b] md:text-base">{s.soru}</span>
                  <span class="faq-chevron shrink-0 text-[#5b6488] transition-transform duration-200">
                    <Icon name="chevron" size={18} />
                  </span>
                </summary>
                <p class="mt-3 text-sm leading-relaxed text-[#5b6488]">{s.cevap}</p>
              </details>
            ))}
          </div>

          <!-- CTA bandi -->
          <div class="reveal mt-14 overflow-hidden rounded-[8px] bg-gradient-to-br from-[#2D3AAE] via-[#3D4EC8] to-[#5060E0] px-6 py-12 text-center md:px-14 md:py-16">

            <h2 class="font-baslik text-2xl font-bold text-white md:text-3xl">
              Hazır Olduğunuzda Bekliyoruz
            </h2>
            <p class="mx-auto mt-3 max-w-md text-sm leading-relaxed text-white/75 md:text-base">
              Ön kayıt formunu doldurun; gerisini birlikte konuşalım.
            </p>

            <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
              <a
                href={KAYIT_URL}
                class="inline-flex items-center gap-2 rounded-buton py-2.5 pl-6 pr-2 text-sm font-semibold shadow-[0_8px_24px_rgba(0,0,0,.20)] transition hover:brightness-95"
                style="background-color: #FFFFFF; color: #2D3AAE;"
              >
                Ön Kayıt Formu
                <span class="grid h-8 w-8 place-items-center rounded-full text-white" style="background-color: #3b6ef0;">
                  <Icon name="arrow" size={15} />
                </span>
              </a>
            </div>

          </div>

        </div>
      </section>

      <Footer />
    </div>
  </div>
</Layout>

<style is:global>
  /* === THEME V13: Deep Purple + Navy === */
  .theme-v13 .bg-white      { background-color: #1B2140; }
  .theme-v13 .bg-white\/95  { background-color: rgba(27, 33, 64, 0.97); }
  .theme-v13 .bg-beyaz      { background-color: #1B2140; }
  .theme-v13 .bg-beyaz\/90  { background-color: rgba(27, 33, 64, 0.90); }

  .theme-v13 .text-lacivert       { color: #8B96CC; }
  .theme-v13 .placeholder\:text-gri\/70::placeholder { color: rgba(100, 110, 170, 0.70); }

  .theme-v13 .from-\[\#7c5cfc\] {
    --tw-gradient-from: #6E7CFF var(--tw-gradient-from-position);
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgb(110 124 255 / 0));
  }
  .theme-v13 .from-\[\#7c5cfc\]\/12 {
    --tw-gradient-from: rgb(110 124 255 / 0.12) var(--tw-gradient-from-position);
    --tw-gradient-stops: var(--tw-gradient-from), var(--tw-gradient-to, rgb(110 124 255 / 0));
  }
  .theme-v13 .to-\[\#3b6ef0\] {
    --tw-gradient-to: #2D3AAE var(--tw-gradient-to-position);
  }
  .theme-v13 .to-\[\#3b6ef0\]\/12 {
    --tw-gradient-to: rgb(45 58 174 / 0.12) var(--tw-gradient-to-position);
  }

  .theme-v13 .bg-\[\#ede8ff\]  { background-color: #1B2140; }
  .theme-v13 .bg-\[\#dfe5f5\]  { background-color: #1E2545; }
  .theme-v13 .bg-\[\#e8eaf4\]  { background-color: #1C2240; }
  .theme-v13 .bg-\[\#f5f8ff\]  { background-color: #181E38; }

  .theme-v13 .text-\[\#1b2a5b\]              { color: #FFFFFF; }
  .theme-v13 .text-\[\#5b6488\]              { color: #8B96CC; }
  .theme-v13 .text-\[\#6b76a0\]              { color: #6B78AA; }
  .theme-v13 .text-\[\#3b6ef0\]              { color: #6E7CFF; }
  .theme-v13 .text-\[\#7c5cfc\]              { color: #6E7CFF; }
  .theme-v13 .hover\:text-\[\#1b2a5b\]:hover { color: #FFFFFF; }

  .theme-v13 .shadow-\[0_8px_20px_rgba\(80\,90\,240\,\.35\)\]  { box-shadow: 0 8px 20px rgba(110,124,255,.40); }
  .theme-v13 .shadow-\[0_8px_20px_rgba\(80\,90\,240\,\.30\)\]  { box-shadow: 0 8px 20px rgba(110,124,255,.35); }
  .theme-v13 .shadow-\[0_12px_30px_rgba\(40\,40\,120\,\.35\)\] { box-shadow: 0 12px 30px rgba(110,124,255,.28); }
  .theme-v13 .shadow-\[0_8px_20px_rgba\(20\,40\,120\,\.35\)\]  { box-shadow: 0 8px 20px rgba(110,124,255,.25); }
  .theme-v13 .shadow-\[0_4px_16px_rgba\(60\,80\,180\,\.06\)\]  { box-shadow: 0 4px 16px rgba(110,124,255,.07); }
  .theme-v13 .shadow-yumusak  { box-shadow: 0 18px 40px rgba(60,80,180,.10); }

  .theme-v13 .bg-mor       { background-color: #6E7CFF; }
  .theme-v13 .bg-turkuaz   { background-color: #22D3EE; }
  .theme-v13 .bg-lacivert  { background-color: #131629; }
  .theme-v13 .bg-bulut     { background-color: #1E2848; }
  .theme-v13 .border-kenar { border-color: #2A3060; }
  .theme-v13 .divide-kenar > * + * { border-color: #2A3060; }
  .theme-v13 .text-mor     { color: #6E7CFF; }
  .theme-v13 .text-turkuaz { color: #22D3EE; }
  .theme-v13 .bg-kenar     { background-color: #2A3060; }
</style>

<script>
  const tog = document.getElementById('mob-tog');
  const nav = document.getElementById('mob-nav');
  tog?.addEventListener('click', () => { nav?.classList.toggle('hidden'); });
  document.querySelectorAll('.mob-link').forEach((l) => {
    l.addEventListener('click', () => nav?.classList.add('hidden'));
  });

  // FAQ chevron rotation
  document.querySelectorAll('.faq-item').forEach((el) => {
    el.addEventListener('toggle', () => {
      const chevron = el.querySelector('.faq-chevron') as HTMLElement | null;
      if (!chevron) return;
      if ((el as HTMLDetailsElement).open) {
        chevron.style.transform = 'rotate(180deg)';
      } else {
        chevron.style.transform = '';
      }
    });
  });

  // Scroll fade-in
  const observer = new IntersectionObserver(
    (entries) => entries.forEach((e) => { if (e.isIntersecting) { (e.target as HTMLElement).classList.add('gorunur'); } }),
    { threshold: 0.08 }
  );
  document.querySelectorAll('.reveal').forEach((el) => observer.observe(el));
</script>

<style>
  .reveal {
    opacity: 0;
    transform: translateY(24px);
    transition: opacity 0.55s ease, transform 0.55s ease;
  }
  .reveal.gorunur {
