---
// Duygusal son itki bolumu. Buton metni/hedefi disaridan gelir:
// - Ana sayfada: uye-ol sayfasina link
// - Uye ol sayfasinda: forma kaydiran anchor (#uye-form)
interface Props {
  butonMetin: string;
  butonHref: string;
}
const { butonMetin, butonHref } = Astro.props;
---

<section class="bg-white px-6 py-12 md:px-10 md:py-16">
  <div class="reveal mx-auto max-w-3xl rounded-[12px] border border-[#2A2F52] bg-gradient-to-br from-[#1A1E3A] to-[#161A33] p-7 text-center shadow-[0_20px_50px_rgba(8,10,24,.4)] md:p-12">
    <h2 class="font-baslik text-2xl font-bold leading-tight text-white md:text-[1.9rem]">
      Sevgili LGS Velileri<br />Bu Yazı Boş Geçirmeyin
    </h2>
    <p class="mx-auto mt-5 max-w-2xl text-sm leading-relaxed text-[#C7CEEF] md:text-base">
      LGS yolculuğunda öne geçenler, Eylül'de başlayanlar değil, yazı doğru değerlendirenlerdir. Uzun bir tatilin ardından Eylül'de düzene girmeye çalışmak hem öğrenciyi hem sizi yorar. Ağustos'ta canlı etütlerle başlayan öğrenci, okul açıldığında çalışma düzenini çoktan kurmuş olur.
    </p>
    <p class="mx-auto mt-4 max-w-2xl text-sm leading-relaxed text-[#C7CEEF] md:text-base">
      <strong class="font-semibold text-white">3 Ağustos'ta</strong> başlayan ücretsiz etütlerle çocuğunuz yaz bitmeden düzenini kursun; sizin de okullar açıldığında gözünüz arkada kalmasın.
    </p>
    <a
      href={butonHref}
      class="mt-7 inline-flex items-center justify-center gap-2 rounded-buton bg-gradient-to-r from-[#F1683C] to-[#ff8a5c] px-6 py-3 text-sm font-semibold text-white shadow-[0_12px_30px_rgba(241,104,60,.35)] transition hover:brightness-105 md:text-base"
    >
      {butonMetin}
    </a>
  </div>
</section>
